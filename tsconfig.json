{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noEmit": true
  },
  "include": ["App.tsx", "index.tsx", "components/**/*.tsx", "services/accessIdAuth.ts", "services/finance/**/*.ts", "types/finance.ts", "types.ts", "utils.ts", "supabaseClient.ts", "vite.config.ts"],
  "exclude": ["supabase/functions", "node_modules", "dist"]
}
