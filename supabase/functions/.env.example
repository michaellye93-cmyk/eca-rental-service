# Server secrets only. Set in Supabase Dashboard > Edge Functions > Secrets.
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_EXISTING_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-pro-preview
# Optional later migration: set AI_PROVIDER=openai and configure these.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-6-astra
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Supabase.
